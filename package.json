{
  "name": "java-game-emu",
  "version": "2.6.6",
  "description": "JavaPlay – J2ME emulator for Android, Windows desktop and the browser",
  "scripts": {
    "serve": "node serve.js",
    "desktop": "npm --prefix desktop start",
    "desktop:build": "npm --prefix desktop run dist",
