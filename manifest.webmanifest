{
  "name": "JavaPlay",
  "short_name": "JavaPlay",
  "description": "Play old Java (J2ME) phone games in your browser.",
  "start_url": "play.html",
  "scope": "./",
  "display": "standalone",
  "background_color": "#14161c",
  "theme_color": "#14161c",
  "icons": [
    { "src": "assets/favicon.svg", "sizes": "any", "type": "image/svg+xml" },
    { "src": "assets/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "assets/javaplay-logo.png", "sizes": "512x512", "type": "image/png" }
  ]
}
