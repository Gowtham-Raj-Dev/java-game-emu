<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="ic_launcher_background">#14161C</color>
    <color name="kp_bg">#0E1014</color>

    <!-- launch theme: logo splash while the app starts -->
    <style name="KeyPlayTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@drawable/splash</item>
        <item name="android:colorAccent">#FF8A1F</item>
        <item name="android:statusBarColor">#171A21</item>
        <item name="android:navigationBarColor">#0E1014</item>
    </style>

    <style name="KeyPlayTheme.Main">
        <item name="android:windowBackground">@color/kp_bg</item>
    </style>
</resources>
